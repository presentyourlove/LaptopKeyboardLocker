<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>KeyLock</AssemblyName>
    <RootNamespace>LaptopKeyboardLocker</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>1.0.0</Version>
    <Authors>LaptopKeyboardLocker Contributors</Authors>
    <Description>A lightweight, dual-mode one-click laptop keyboard locker for Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>

